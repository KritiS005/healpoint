generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileRole {
  patient
  doctor
  admin
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum AppointmentStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
  no_show
}

enum CallRoomStatus {
  created
  waiting
  active
  ended
  failed
}

enum RecordType {
  lab_report
  prescription
  scan
  other
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  partially_refunded
}

enum NotificationType {
  booking
  payment
  call
  system
}

enum AiContextType {
  report
  prescription
  general
}

enum AuditAction {
  admin_doctor_verify
  payment_status_changed
  refund_requested
  appointment_status_changed
  ai_safety_blocked
  record_soft_deleted
}

model Profile {
  id            String           @id @db.Uuid
  fullName      String           @map("full_name")
  role          ProfileRole      @default(patient)
  avatarUrl     String?          @map("avatar_url")
  phone         String?
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  doctor        Doctor?
  patient       Patient?
  notifications Notification[]
  aiMessages    AiConversation[]
  auditLogs     AuditLog[]       @relation("AuditActor")

  @@map("profiles")
}

model Doctor {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId       String        @unique @map("profile_id") @db.Uuid
  specialty       String
  bio             String?
  verified        Boolean       @default(false)
  rating          Decimal       @default(0.0) @db.Decimal(2, 1)
  consultationFee Int           @map("consultation_fee")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  profile         Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  prescriptions   Prescription[]

  @@index([specialty])
  @@index([verified])
  @@map("doctors")
}

model Patient {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId             String          @unique @map("profile_id") @db.Uuid
  dateOfBirth           DateTime?       @map("date_of_birth") @db.Date
  gender                Gender?
  medicalHistorySummary String?         @map("medical_history_summary")
  profile               Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  appointments          Appointment[]
  medicalRecords        MedicalRecord[]
  prescriptions         Prescription[]

  @@map("patients")
}

model Appointment {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId       String            @map("patient_id") @db.Uuid
  doctorId        String            @map("doctor_id") @db.Uuid
  scheduledAt     DateTime          @map("scheduled_at") @db.Timestamptz(6)
  durationMinutes Int               @default(30) @map("duration_minutes")
  status          AppointmentStatus @default(pending)
  roomId          String?           @unique @map("room_id") @db.Uuid
  notes           String?
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  patient         Patient           @relation(fields: [patientId], references: [id])
  doctor          Doctor            @relation(fields: [doctorId], references: [id])
  room            CallRoom?
  prescription    Prescription?
  payment         Payment?

  @@unique([doctorId, scheduledAt])
  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}

model CallRoom {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId     String         @unique @map("appointment_id") @db.Uuid
  status            CallRoomStatus @default(created)
  startedAt         DateTime?      @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime?      @map("ended_at") @db.Timestamptz(6)
  patientJoinedAt   DateTime?      @map("patient_joined_at") @db.Timestamptz(6)
  doctorJoinedAt    DateTime?      @map("doctor_joined_at") @db.Timestamptz(6)
  appointment        Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("call_rooms")
}

model MedicalRecord {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId   String     @map("patient_id") @db.Uuid
  fileUrl     String     @map("file_url")
  recordType  RecordType @default(other) @map("record_type")
  aiSummary   String?    @map("ai_summary")
  uploadedAt  DateTime   @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  patient     Patient    @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("medical_records")
}

model Prescription {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String      @unique @map("appointment_id") @db.Uuid
  doctorId      String      @map("doctor_id") @db.Uuid
  patientId     String      @map("patient_id") @db.Uuid
  content       Json
  issuedAt      DateTime    @default(now()) @map("issued_at") @db.Timestamptz(6)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  patient       Patient     @relation(fields: [patientId], references: [id])

  @@map("prescriptions")
}

model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String        @unique @map("appointment_id") @db.Uuid
  amount        Int
  currency      String        @default("inr")
  status        PaymentStatus @default(pending)
  provider      String        @default("razorpay")
  providerRef   String?       @unique @map("provider_ref")
  orderId       String?       @unique @map("order_id")
  receiptUrl    String?       @map("receipt_url")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])

  @@index([status])
  @@index([providerRef])
  @@map("payments")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user      Profile          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model AiConversation {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  sessionId   String        @map("session_id") @db.Uuid
  message     String
  response    String
  contextType AiContextType @map("context_type")
  tokenCount  Int?          @map("token_count")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user        Profile       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("ai_conversations")
}

model AuditLog {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId   String?     @map("actor_id") @db.Uuid
  action    AuditAction
  entity    String
  entityId  String      @map("entity_id")
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  actor     Profile?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
